# Local development: dev.py binds both servers to loopback.
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DATABASE_URL=sqlite:///absolute/path/chakrasetu.db
# UPLOAD_DIR=/absolute/path/uploads
# Use a durable directory/volume for evidence and logos; back up with the database.
# CAPACITY_HOLD_MINUTES=30
# TELEMETRY_THRESHOLDS={"TEMPERATURE":50,"SHOCK":3,"PROLONGED_STOP":30,"ROUTE_DEVIATION":5}
# Production requires HTTPS and APP_ENV=production (Secure cookies; synthetic accounts disabled).
# No default credentials or session secret. Sessions are random and stored as hashes.
# .env is a template, not auto-loaded. Export chosen variables in your shell.
# CHAKRA_DEMO_PASSWORD is an optional development CLI input. Do not put it in source or logs.

# Optional administrator-managed PBS description/constraint configuration (restart required)
# PBS_POLICY_PATH=/absolute/path/to/pbs_policy.json
